<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <ApplicationId>com.projectalice.vision</ApplicationId>
    <ApplicationTitle>Alice·空间伙伴</ApplicationTitle>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.3</ApplicationDisplayVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseInterpreter>false</UseInterpreter>
    <MtouchLink>SdkOnly</MtouchLink>
    <CodesignEntitlements></CodesignEntitlements>
    <EnableCodeSigning>false</EnableCodeSigning>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AliceVision.Core\AliceVision.Core.csproj" />
  </ItemGroup>
</Project>
